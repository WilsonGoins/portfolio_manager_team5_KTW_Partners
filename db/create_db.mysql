CREATE DATABASE portfolio

USE portfolio

CREATE TABLE holdings (
  ticker CHAR(5) PRIMARY KEY,
  name VARCHAR(20) NOT NULL,
  h_type VARCHAR(10),
  quantity_shares INT NOT NULL,
  current_price DECIMAL(10, 4) NOT NULL,
  market_value DECIMAL(10, 4) NOT NULL,
  change_today DECIMAL(7,4),
  gain_loss DECIMAL(10, 4),
  allocation_percentage DECIMAL(10, 4)
);

CREATE TABLE transactions (
  trans_id INT AUTO_INCREMENT PRIMARY KEY,
  ticker CHAR(5) FOREIGN KEY NOT NULL,
  quantity INT NOT NULL,
  price DECIMAL(10, 4) NOT NULL,
  purchase_date TIMESTAMP NOT NULL,
  action_taken VARCHAR(15) NOT NULL,
);
